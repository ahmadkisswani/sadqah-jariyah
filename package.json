{
  "name": "sadqah-jariyah",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "صدقة جارية — موقع إسلامي عربي modern/PWA مكرَّس لتوبة عبد العزيز الجربوعه ومحمد احمد مسلم",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/generate-seo.mjs",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-test.mjs",
    "test": "npm run test:prayer && npm run test:events && npm run test:share && npm run test:content && npm run test:phase2",
    "test:prayer": "node scripts/prayer-logic-test.mjs",
    "test:events": "node scripts/events-test.mjs",
    "test:share": "node scripts/share-test.mjs",
    "test:content": "node scripts/content-test.mjs",
    "test:phase2": "node scripts/phase2-logic-test.mjs",
    "verify": "node scripts/verify-build.mjs",
    "deploy": "npx wrangler deploy",
    "deploy:ci": "npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/amiri": "^5.1.0",
    "@fontsource/noto-naskh-arabic": "^5.1.0",
    "@fontsource/noto-sans-arabic": "^5.1.0",
    "@mui/icons-material": "^6.4.0",
    "@mui/material": "^6.4.0",
    "leaflet": "^1.9.4",
