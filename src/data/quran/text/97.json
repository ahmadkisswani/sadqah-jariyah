[{"number":6126,"numberInSurah":1,"text":"إِنَّآ أَنزَلْنَٰهُ فِى لَيْلَةِ ٱلْقَدْرِ","page":598,"juz":30},{"number":6127,"numberInSurah":2,"text":"وَمَآ أَدْرَىٰكَ مَا لَيْلَةُ ٱلْقَدْرِ","page":598,"juz":30},{"number":6128,"numberInSurah":3,"text":"لَيْلَةُ ٱلْقَدْرِ خَيْرٌۭ مِّنْ أَلْفِ شَهْرٍۢ","page":598,"juz":30},{"number":6129,"numberInSurah":4,"text":"تَنَزَّلُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذْنِ رَبِّهِم مِّن كُلِّ أَمْرٍۢ","page":598,"juz":30},{"number":6130,"numberInSurah":5,"text":"سَلَٰمٌ هِىَ حَتَّىٰ مَطْلَعِ ٱلْفَجْرِ","page":598,"juz":30}]