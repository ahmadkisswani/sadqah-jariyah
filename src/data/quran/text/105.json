[{"number":6189,"numberInSurah":1,"text":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ ٱلْفِيلِ","page":601,"juz":30},{"number":6190,"numberInSurah":2,"text":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍۢ","page":601,"juz":30},{"number":6191,"numberInSurah":3,"text":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ","page":601,"juz":30},{"number":6192,"numberInSurah":4,"text":"تَرْمِيهِم بِحِجَارَةٍۢ مِّن سِجِّيلٍۢ","page":601,"juz":30},{"number":6193,"numberInSurah":5,"text":"فَجَعَلَهُمْ كَعَصْفٍۢ مَّأْكُولٍۭ","page":601,"juz":30}]