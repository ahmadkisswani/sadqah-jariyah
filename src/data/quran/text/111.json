[{"number":6217,"numberInSurah":1,"text":"تَبَّتْ يَدَآ أَبِى لَهَبٍۢ وَتَبَّ","page":603,"juz":30},{"number":6218,"numberInSurah":2,"text":"مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ","page":603,"juz":30},{"number":6219,"numberInSurah":3,"text":"سَيَصْلَىٰ نَارًۭا ذَاتَ لَهَبٍۢ","page":603,"juz":30},{"number":6220,"numberInSurah":4,"text":"وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ","page":603,"juz":30},{"number":6221,"numberInSurah":5,"text":"فِى جِيدِهَا حَبْلٌۭ مِّن مَّسَدٍۭ","page":603,"juz":30}]